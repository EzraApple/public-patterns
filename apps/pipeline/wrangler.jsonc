{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-patterns-pipeline",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "vars": {
    "PUBLIC_PATTERNS_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "public-patterns-pipeline",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "INVESTIGATOR",
      "service": "public-patterns-investigator"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
